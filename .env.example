# PostgreSQL connection string (Supabase pooler or direct Postgres URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (Supabase direct connection port, usually 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secret used to sign session JWT cookies (use a long random string in production)
SESSION_SECRET="replace-with-a-long-random-secret"

# Supabase project URL (Settings → API)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Supabase service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: credentials created by `npm run db:seed` for local development
ADMIN_EMAIL="admin@switchboard.local"
ADMIN_PASSWORD="admin1234"
